# Supabase Postgres
# Transaction-mode pooler (runtime)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler (migrations)
DIRECT_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google OAuth (Web client) + YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
# No redirect URI here: it is derived from the request origin at runtime, so every
# origin you use must be registered in the Google Cloud OAuth client, e.g.
#   http://localhost:3000/api/youtube/callback
#   https://<your-domain>/api/youtube/callback

# 32-byte base64 key used to encrypt OAuth tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Auth.js (NextAuth v5)
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true    # required on Railway (and any non-Vercel host)
# Railway: set DATABASE_URL (+ DIRECT_URL if using a pooler). Migrations run via
# railway.json preDeployCommand: `npx prisma migrate deploy`
# Google login — leave blank to keep the Google button disabled
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# When enabling Google login, register this redirect URI in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google

# Optional: Buddy chat providers
OPENAI_API_KEY=
GEMINI_API_KEY=
