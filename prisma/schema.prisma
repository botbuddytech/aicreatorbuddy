generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

enum VideoSessionStatus {
  DRAFT
  IN_PROGRESS
  RENDERED
  EXPORTED
  ABANDONED
}

enum CreateStep {
  SUMMARY
  TITLE
  THUMBNAIL
  SCRIPT
  TIMELINE
  DESCRIPTION
  RENDER
  EDITOR
}

enum StepState {
  NOT_STARTED
  DRAFT
  GENERATED
  APPROVED
}

enum VideoAssetKind {
  UPLOADED_CLIP
  AI_IMAGE
  VOICEOVER
  CUSTOM_THUMBNAIL
  STOCK
}

enum VideoAssetSource {
  MANUAL_UPLOAD
  AI_GENERATED
  STOCK
  EXTERNAL_URL
}

enum VideoExportStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReferenceTranscriptStatus {
  EMPTY
  FETCHING
  READY
  FAILED
}

enum IntegrationProvider {
  YOUTUBE
  VIDIQ
  CHATGPT
  GEMINI
  ELEVENLABS
  SEEDANCE
  HIGGSFIELD
  REMOTION
}

enum IntegrationAuthKind {
  OAUTH
  API_KEY
  NONE
}

enum IntegrationConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  NEEDS_REAUTH
  INVALID_KEY
  REVOKED
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  sessions             Session[]
  youtubeChannels      YoutubeChannel[]      @relation("OwnedChannels")
  channelShares        ChannelShare[]        @relation("ChannelShareMember")
  channelSharesSent    ChannelShare[]        @relation("ChannelShareInviter")
  videoSessions        VideoSession[]
  deletedVideoSessions DeletedVideoSession[]
  cursorPromptSettings CursorPromptSettings?
  integrations         UserIntegration[]
  higgsfieldAccounts   HiggsfieldAccount[]
  activeChannelId      String?
  activeChannel        YoutubeChannel?       @relation("UserActiveChannel", fields: [activeChannelId], references: [id], onDelete: SetNull)

  @@index([activeChannelId])
}

model CursorPromptSettings {
  userId                 String   @id
  titleGenerationPrompt  String?  @db.Text
  titleScoringPrompt     String?  @db.Text
  scriptScoringPrompt    String?  @db.Text
  scriptLowEffortPrompt  String?  @db.Text
  thumbnailPromptGenerationPrompt  String?  @db.Text
  scriptGenerationPrompt String?  @db.Text
  descriptionGenerationPrompt String?  @db.Text
  visualPromptGenerationPrompt String?  @db.Text
  titleGenerationDefault String?  @db.Text
  titleScoringDefault    String?  @db.Text
  scriptScoringDefault   String?  @db.Text
  scriptLowEffortDefault String?  @db.Text
  thumbnailPromptGenerationDefault String?  @db.Text
  scriptGenerationDefault String?  @db.Text
  descriptionGenerationDefault String?  @db.Text
  visualPromptGenerationDefault String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One shared prompt per visual style. A video may keep its own copy outside this table.
model VisualStyle {
  id        String   @id
  prompt    String   @db.Text
  updatedAt DateTime @updatedAt
}

model UserIntegration {
  id               String                      @id @default(cuid())
  userId           String
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         IntegrationProvider
  authKind         IntegrationAuthKind
  status           IntegrationConnectionStatus @default(NOT_CONNECTED)
  enabled          Boolean                     @default(false)
  apiKeyEnc        String?
  apiKeyLast4      String?
  apiKeyAddedAt    DateTime?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  scope            String?
  oauthClientId    String?
  accountLabel     String?
  plan             String?
  environment      String                      @default("Production")
  quotaUsed        Int?
  quotaLimit       Int?
  quotaUnit        String?
  quotaResetsAt    DateTime?
  quotaSyncedAt    DateTime?
  lastUsedAt       DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  lastErrorAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  usage            IntegrationUsage[]

  @@unique([userId, provider])
  @@index([provider, status])
}

model HiggsfieldAccount {
  id               String                      @id @default(cuid())
  userId           String
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  apiKeyEnc        String
  apiKeyLast4      String
  status           IntegrationConnectionStatus @default(CONNECTED)
  enabled          Boolean                     @default(true)
  estimateCredits  String?
  estimateUsd      String?
  lastErrorMessage String?
  lastUsedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([userId, email])
  @@index([userId, enabled])
}

model IntegrationUsage {
  id                String              @id @default(cuid())
  userIntegrationId String
  userIntegration   UserIntegration     @relation(fields: [userIntegrationId], references: [id], onDelete: Cascade)
  userId            String
  provider          IntegrationProvider
  operation         String
  method            String?
  httpStatus        Int?
  ok                Boolean             @default(true)
  latencyMs         Int?
  units             Int                 @default(0)
  estimatedUsd      Decimal             @default(0) @db.Decimal(12, 6)
  sessionId         String?
  step              CreateStep?
  channelId         String?
  at                DateTime            @default(now())

  @@index([userId, provider, at(sort: Desc)])
  @@index([userIntegrationId, at(sort: Desc)])
}

model McpClientRegistration {
  id           String   @id @default(cuid())
  server       String
  redirectUri  String
  clientId     String
  clientSecret String?
  createdAt    DateTime @default(now())

  @@unique([server, redirectUri])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One connected YouTube channel. Each row owns its own OAuth tokens because
/// Google scopes a token to the account/brand channel chosen on the consent screen.
model YoutubeChannel {
  id                    String                  @id @default(cuid())
  userId                String
  user                  User                    @relation("OwnedChannels", fields: [userId], references: [id], onDelete: Cascade)
  channelId             String // "UC..."
  title                 String
  customUrl             String?
  thumbnailUrl          String?
  subscriberCount       BigInt                  @default(0)
  /// True when the channel hides its subscriber count; subscriberCount is then unreliable.
  hiddenSubscriberCount Boolean                 @default(false)
  viewCount             BigInt                  @default(0)
  /// YouTube reports public videos only, so this can be lower than the synced upload count.
  videoCount            Int                     @default(0)
  uploadsPlaylistId     String
  googleEmail           String?
  scope                 String
  accessTokenEnc        String
  refreshTokenEnc       String
  tokenExpiresAt        DateTime
  status                ChannelConnectionStatus @default(ACTIVE)
  lastSyncedAt          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  videos                YoutubeVideo[]
  playlists             YoutubePlaylist[]
  analyticsSnapshots    YoutubeAnalyticsSnapshot[]
  videoSessions         VideoSession[]
  shares                ChannelShare[]
  activeForUsers        User[]                  @relation("UserActiveChannel")

  @@unique([userId, channelId])
  @@index([userId])
}

model ChannelShare {
  id          String         @id @default(cuid())
  channelId   String
  channel     YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Normalized lowercase invite address; the grant may exist before the account does.
  email       String
  userId      String?
  user        User?          @relation("ChannelShareMember", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User           @relation("ChannelShareInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  acceptedAt  DateTime?

  @@unique([channelId, email])
  @@index([userId])
  @@index([email])
}

model YoutubeVideo {
  id            String         @id @default(cuid())
  videoId       String // YouTube video id
  channelId     String
  channel       YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title         String
  description   String         @default("")
  thumbnailUrl  String?
  publishedAt   DateTime
  durationSec   Int?
  viewCount     BigInt         @default(0)
  likeCount     BigInt         @default(0)
  commentCount  BigInt         @default(0)
  privacyStatus String         @default("private")
  /// status.uploadStatus: uploaded | processed | failed | rejected | deleted
  uploadStatus  String         @default("processed")
  tags          String[]       @default([])
  categoryId    String?
  /// Set when YouTube will publish a private video later.
  publishAt     DateTime?
  fetchedAt     DateTime       @default(now())

  @@unique([channelId, videoId])
  @@index([channelId, publishedAt(sort: Desc)])
  @@index([channelId, publishAt])
}

model YoutubePlaylist {
  id            String         @id @default(cuid())
  playlistId    String
  channelId     String
  channel       YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title         String
  description   String         @default("")
  thumbnailUrl  String?
  itemCount     Int            @default(0)
  privacyStatus String         @default("private")
  publishedAt   DateTime?
  fetchedAt     DateTime       @default(now())

  @@unique([channelId, playlistId])
  @@index([channelId])
}

/// Cached YouTube Analytics report for one channel and date range.
model YoutubeAnalyticsSnapshot {
  id           String         @id @default(cuid())
  channelId    String
  channel      YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reportKey    String
  rangeKey     String
  payload      Json
  errorMessage String?
  fetchedAt    DateTime       @default(now())

  @@unique([channelId, reportKey, rangeKey])
  @@index([channelId, fetchedAt])
}

model VideoSession {
  id                 String                  @id
  userId             String
  workspaceId        String                  @default("default")
  name               String                  @default("Untitled video")
  status             VideoSessionStatus      @default(DRAFT)
  currentStep        CreateStep              @default(SUMMARY)
  channelId          String?
  channelTitle       String?
  topic              String                  @default("")
  format             String                  @default("long-form")
  aspectRatio        String                  @default("16:9")
  intent             String                  @default("educational")
  /// Selected subcategory for the current intent. Validated in the app.
  intentCategory     String?
  targetDurationSec  Int                     @default(480)
  referenceCount     Int                     @default(0)
  apiCallCount       Int                     @default(0)
  generationCount    Int                     @default(0)
  regenerateCount    Int                     @default(0)
  manualClipCount    Int                     @default(0)
  aiVisualCount      Int                     @default(0)
  voiceoverCount     Int                     @default(0)
  sceneCount         Int                     @default(0)
  approvedStepCount  Int                     @default(0)
  exportAttemptCount Int                     @default(0)
  exportSuccessCount Int                     @default(0)
  timelineSeconds    Int                     @default(0)
  estimatedCostUsd   Decimal                 @default(0) @db.Decimal(12, 6)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  lastActiveAt       DateTime                @default(now())
  renderedAt         DateTime?
  firstExportedAt    DateTime?
  /// YouTube video id after a successful publish from this project.
  youtubeVideoId     String?
  deletedAt          DateTime?
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel            YoutubeChannel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  steps              VideoSessionStep[]
  events             VideoSessionEvent[]
  apiCalls           VideoSessionApiCall[]
  assets             VideoSessionAsset[]
  scenes             VideoSessionScene[]
  exports            VideoSessionExport[]
  checks             VideoSessionCheck[]
  references         VideoSessionReference[]

  @@index([userId, lastActiveAt(sort: Desc)])
  @@index([channelId])
  @@index([status])
  @@index([youtubeVideoId])
}

model DeletedVideoSession {
  id        String   @id
  userId    String
  deletedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt(sort: Desc)])
}

model VideoSessionStep {
  id               String       @id @default(cuid())
  sessionId        String
  step             CreateStep
  state            StepState    @default(NOT_STARTED)
  provider         String?
  /// Metrics rollup for session overview (counts, selected labels).
  data             Json         @default("{}")
  /// Working document this step owns. Schema version 0 = metrics-only legacy row.
  payload          Json         @default("{}")
  schemaVersion    Int          @default(0)
  visitCount       Int          @default(0)
  generationCount  Int          @default(0)
  editCount        Int          @default(0)
  apiCallCount     Int          @default(0)
  timeSpentMs      Int          @default(0)
  enteredAt        DateTime?
  firstGeneratedAt DateTime?
  approvedAt       DateTime?
  updatedAt        DateTime     @updatedAt
  session          VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, step])
}

model VideoSessionEvent {
  id            String       @id @default(cuid())
  sessionId     String
  step          CreateStep?
  type          String
  at            DateTime
  sequence      Int
  payload       Json         @default("{}")
  clientEventId String       @unique
  session       VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([sessionId, sequence])
}

model VideoSessionApiCall {
  id           String       @id @default(cuid())
  sessionId    String
  step         CreateStep
  tool         String
  kind         String
  estimatedUsd Decimal      @default(0) @db.Decimal(12, 6)
  ok           Boolean      @default(true)
  latencyMs    Int?
  at           DateTime
  clientCallId String       @unique
  session      VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
}

model VideoSessionAsset {
  id          String           @id @default(cuid())
  sessionId   String
  sceneKey    String?
  kind        VideoAssetKind
  source      VideoAssetSource
  addedAtStep CreateStep
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  durationSec Float?
  localClipId String?
  storageUrl  String?
  addedAt     DateTime         @default(now())
  removedAt   DateTime?
  session     VideoSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, localClipId])
  @@index([sessionId, addedAt])
}

model VideoSessionScene {
  id           String       @id @default(cuid())
  sessionId    String
  sceneKey     String
  order        Int
  sectionLabel String
  status       String
  durationSec  Float
  trimStartSec Float
  transition   String
  filter       String
  speed        Float
  volume       Int
  hasClip      Boolean
  hasVoiceover Boolean
  wordCount    Int
  session      VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sceneKey])
  @@index([sessionId, order])
}

model VideoSessionExport {
  id           String            @id
  sessionId    String
  attempt      Int
  status       VideoExportStatus
  fileName     String?
  format       String
  aspectRatio  String
  resolution   String
  runtimeSec   Float
  sceneCount   Int
  durationMs   Int?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime?
  session      VideoSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
}

model VideoSessionCheck {
  id         String       @id @default(cuid())
  sessionId  String
  scope      String
  provider   String       @default("static")
  verdict    String
  score      Int
  sourceHash String
  summary    String?      @db.Text
  findings   Json         @default("[]")
  checkedAt  DateTime
  session    VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, scope, sourceHash, provider])
  @@index([sessionId, checkedAt])
}

model VideoSessionReference {
  id           String                    @id @default(cuid())
  sessionId    String
  /// Client-side ReferenceVideo.id, stable across snapshot syncs.
  referenceKey String
  order        Int                       @default(0)
  url          String                    @default("")
  videoId      String?
  status       ReferenceTranscriptStatus @default(EMPTY)
  source       String                    @default("manual")
  lang         String?
  transcript   String                    @default("")
  /// [{ text, offsetMs, durationMs }] kept server-side for later scene alignment.
  segments     Json                      @default("[]")
  /// Extensible reference metadata (title, thumbnail, channel) without new columns.
  metadata     Json                      @default("{}")
  charCount    Int                       @default(0)
  wordCount    Int                       @default(0)
  durationSec  Float?
  errorCode    String?
  errorMessage String?
  fetchedAt    DateTime?
  removedAt    DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  session      VideoSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, referenceKey])
  @@index([sessionId, order])
}
